{
 "source": "dome-ml-observatory-triage moros_pipeline/scripts/datalinks_resources.py (slug, label, category), with designations from the lists below",
 "decided": "2026-11-25",
 "version_note": "v1.9.2 (2026-11-25): adds ModelArchive (an ELIXIR Deposition Database), which Europe PMC's /datalinks route lists. v1.9.1 (2026-11-25): every designation sourced; host, host_source and ELIXIR Nodes read from each resource's own pages. FAIRsharing could not be read as a cross-check (its records render in the browser and its API needs a login).",
 "decision_note": "One entry per data-link resource slug, so the Observatory can group and filter linked resources by who runs them and how they are designated without stamping every document. `kind` says whether a slug is a data resource at all: only `data` resources are ranked on the Data page; software registries, transparency reports, code hosts, model hubs, generic identifiers and ontologies are listed but not ranked. A designation field holds the name of the designated entry the resource is, or belongs to (PRIDE carries ProteomeXchange Consortium), and null when it has none. A designation whose list has status `pending` has not been sourced yet, so its nulls mean unknown, not no.",
 "kinds": {
  "data": "a database or archive holding research data or curated knowledge records",
  "ontology": "an ontology or controlled vocabulary; links are mentions of its terms",
  "identifier": "a generic identifier scheme rather than one resource (RRID, an unattributed data DOI)",
  "code": "a code host or code archive",
  "model_hub": "a hub for trained models",
  "software_registry": "a registry describing software (bio.tools)",
  "transparency_report": "a registry of reporting statements (DOME Registry)"
 },
 "designations": {
  "embl_ebi": {
   "label": "EMBL-EBI",
   "status": "sourced",
   "source": "Each resource's own pages (host_source): a resource is marked when EMBL-EBI is among the institutions that run it, and then also carries the EMBL-EBI Node. Joint resources keep every partner, e.g. EGA (EMBL-EBI and CRG, Spain), UniProt (EMBL-EBI and SIB, Switzerland).",
   "retrieved": "2026-11-25"
  },
  "gcbr": {
   "label": "Global Core Biodata Resource",
   "status": "sourced",
   "source": "https://globalbiodata.org/what-we-do/global-core-biodata-resources/list-of-current-global-core-biodata-resources/",
   "retrieved": "2026-11-25",
   "entries": 52
  },
  "elixir_cdr": {
   "label": "ELIXIR Core Data Resource",
   "status": "sourced",
   "source": "https://elixir-europe.org/platforms/data/core-data-resources",
   "retrieved": "2026-11-25",
   "entries": 41,
   "note": "Copied from the page by the project owner: elixir-europe.org refuses automated requests. Member databases of an umbrella entry carry it (IntAct and MINT: IMEx; Pfam: InterPro; UniParc: UniProt)."
  },
  "elixir_edd": {
   "label": "ELIXIR Deposition Database",
   "status": "sourced",
   "source": "https://elixir-europe.org/platforms/data/elixir-deposition-databases",
   "retrieved": "2026-11-25",
   "entries": 18,
   "note": "Read from the Internet Archive's copy of the page dated 2026-08-31 (https://web.archive.org/web/20260831071102/https://elixir-europe.org/platforms/data/elixir-deposition-databases), as elixir-europe.org refuses automated requests. It includes the January 2026 additions (BioImage Archive, DisProt). ELIXIR's announcement of that round gives the total as 17 while the page lists 18; the page is followed here. DisProt and LIPID MAPS are on the list but have no slug in the catalogue yet."
  },
  "elixir_nodes": {
   "label": "ELIXIR Node",
   "status": "sourced",
   "source": "https://elixir-europe.org/about-us/who-we-are/nodes",
   "retrieved": "2026-11-25",
   "entries": 25,
   "note": "A resource carries the Node of each institution that runs it, read from the resource's own pages (host_source), with FAIRsharing as a cross-check. EMBL-EBI is listed as a Node of its own. A resource run only outside ELIXIR member countries carries none."
  }
 },
