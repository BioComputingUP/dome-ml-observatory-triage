# Root .env -- read by docker-compose.yml into the `pipeline` container. Copy to `.env` and fill in.
# The real .env is gitignored. Never paste a key into docker-compose.yml or a shell command.

# DeepSeek API key: the only paid credential in this repository. Used by
# `dome-triage llm-classify classify | enrich | calibrate`. Check the balance any time with
#   curl -s -H "Authorization: Bearer $DEEPSEEK_API_KEY" https://api.deepseek.com/user/balance
DEEPSEEK_API_KEY=

# Optional NCBI E-utilities key (lifts the metadata-repair rate ceiling from 3 to 10 req/s).
NCBI_API_KEY=

# Optional Crossref "polite pool" contact email -- Crossref serves those requests faster.
CROSSREF_MAILTO=

# Where the external data repositories live, for the source-loading and full-text steps that read
# them (configs/sources.yaml, configs/pipeline.yaml). Leave it unset unless they are somewhere
# other than beside this repo: the default is this repository's parent directory, derived at
# runtime, so a normal checkout needs no value here. Never put an absolute home path in a tracked
# file -- scripts/check_no_absolute_paths.py fails the moment one appears.
DOME_TRIAGE_DATA_ROOT=

# Zenodo personal access token (scopes deposit:write and deposit:actions), for
# scripts/zenodo_archive.py, which archives the corpus as a new version of the Observatory's Zenodo
# record after a load. Host-only: docker-compose.yml passes the three keys above into the container
# by name, never this one. Rotate it on Zenodo if it is ever pasted anywhere else.
ZENODO_TOKEN=

# The MongoDB connection lives in moros_pipeline/.env (see moros_pipeline/.env.example), not here:
# nothing inside the container ever connects to the database.
