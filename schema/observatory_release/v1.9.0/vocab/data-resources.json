{
 "source": "dome-ml-observatory-triage moros_pipeline/scripts/datalinks_resources.py (slug, label, category), with designations from the lists below",
 "decided": "2026-11-25",
 "decision_note": "One entry per data-link resource slug, so the Observatory can group and filter linked resources by who runs them and how they are designated without stamping every document. `kind` says whether a slug is a data resource at all: only `data` resources are ranked on the Data page; software registries, transparency reports, code hosts, model hubs, generic identifiers and ontologies are listed but not ranked. A designation field holds the name of the designated entry the resource is, or belongs to (PRIDE carries ProteomeXchange Consortium), and null when it has none. A designation whose list has status `pending` has not been sourced yet, so its nulls mean unknown, not no.",
 "kinds": {
  "data": "a database or archive holding research data or curated knowledge records",
  "ontology": "an ontology or controlled vocabulary; links are mentions of its terms",
  "identifier": "a generic identifier scheme rather than one resource (RRID, an unattributed data DOI)",
  "code": "a code host or code archive",
  "model_hub": "a hub for trained models",
  "software_registry": "a registry describing software (bio.tools)",
  "transparency_report": "a registry of reporting statements (DOME Registry)"
 },
 "designations": {
  "embl_ebi": {
   "label": "EMBL-EBI",
   "status": "sourced",
   "source": "Resource operator as stated on each resource's own site; started from the dome-ml-observatory-research EBI_HOSTED set and reviewed 2026-11-25. A resource run by a consortium in which EMBL-EBI hosts a full copy or is a named operating partner counts.",
   "retrieved": "2026-11-25"
  },
  "gcbr": {
   "label": "Global Core Biodata Resource",
   "status": "sourced",
   "source": "https://globalbiodata.org/what-we-do/global-core-biodata-resources/list-of-current-global-core-biodata-resources/",
   "retrieved": "2026-11-25",
   "entries": 52
  },
  "elixir_cdr": {
