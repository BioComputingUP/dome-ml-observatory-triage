# Connection to the MongoDB server that hosts the DOME Observatory corpus (referred to
# throughout this project as "moros", which is the production host's name).
#
# There is no authentication on this server, so nothing here is a credential -- but the host
# address is internal, so the real .env is gitignored and only this example is tracked. The
# sibling repo ../dome-ml-observatory was sanitised for exactly this reason; keep it that way.
#
# Production uses the hostname form (mongodb://moros:27017); from the lab VPN use the address.
MONGODB_URI=mongodb://mongodb-host:27017
MONGODB_DB=dome_observatory
MONGODB_COLLECTION=Content
